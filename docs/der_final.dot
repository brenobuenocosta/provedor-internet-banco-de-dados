digraph DER {
  graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.7, ranksep=1.5, splines=true,
         fontname="Inter", label=<<B>DER Final (3FN) - Sistema de Gestão para Provedor de Internet</B>>, labelloc=t, fontsize=26];
  node  [shape=plain, fontname="Inter", fontsize=13];
  edge  [fontname="Inter", fontsize=13, color="#333333", penwidth=1.6, dir=both,
         arrowtail=teetee, arrowhead=crowodot, arrowsize=1.3, labeldistance=2.2, labelfontsize=14];

  CLIENTE [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79">
      <TR><TD COLSPAN="3" BGCOLOR="#1f6fb2"><FONT COLOR="white"><B>CLIENTE</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_cliente</B></TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>UK</B></TD><TD ALIGN="LEFT">cpf</TD><TD ALIGN="LEFT">CHAR(11)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">telefone</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
    </TABLE>>];

  PLANO [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79">
      <TR><TD COLSPAN="3" BGCOLOR="#1f6fb2"><FONT COLOR="white"><B>PLANO</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_plano</B></TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">velocidade_mbps</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">valor_mensal</TD><TD ALIGN="LEFT">DECIMAL(8,2)</TD></TR>
    </TABLE>>];

  CONTRATO [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79">
      <TR><TD COLSPAN="3" BGCOLOR="#1f6fb2"><FONT COLOR="white"><B>CONTRATO</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_contrato</B></TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_cliente</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_plano</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_endereco</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">data_inicio</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">dia_vencimento</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR>
    </TABLE>>];

  FATURA [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79">
      <TR><TD COLSPAN="3" BGCOLOR="#1f6fb2"><FONT COLOR="white"><B>FATURA</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_fatura</B></TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_contrato</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">mes_referencia</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">valor</TD><TD ALIGN="LEFT">DECIMAL(8,2)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">data_vencimento</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR>
    </TABLE>>];

  PAGAMENTO [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79">
      <TR><TD COLSPAN="3" BGCOLOR="#1f6fb2"><FONT COLOR="white"><B>PAGAMENTO</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_pagamento</B></TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_fatura</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">data_pagamento</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">valor_pago</TD><TD ALIGN="LEFT">DECIMAL(8,2)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">forma_pagamento</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
    </TABLE>>];

  CHAMADO [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79">
      <TR><TD COLSPAN="3" BGCOLOR="#1f6fb2"><FONT COLOR="white"><B>CHAMADO_SUPORTE</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_chamado</B></TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_contrato</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_tecnico</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">descricao_problema</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">data_abertura</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">diagnostico</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">solucao</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">data_conclusao</TD><TD ALIGN="LEFT">DATE</TD></TR>
    </TABLE>>];

  TECNICO [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79">
      <TR><TD COLSPAN="3" BGCOLOR="#1f6fb2"><FONT COLOR="white"><B>TÉCNICO</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_tecnico</B></TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">telefone</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR>
    </TABLE>>];


  ENDERECO [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79">
      <TR><TD COLSPAN="3" BGCOLOR="#2e8b57"><FONT COLOR="white"><B>ENDEREÇO</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_endereco</B></TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD><B>FK</B></TD><TD ALIGN="LEFT">id_cidade</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">logradouro</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">numero</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">complemento</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">bairro</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">cep</TD><TD ALIGN="LEFT">CHAR(8)</TD></TR>
    </TABLE>>];

  CIDADE [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#1f4e79">
      <TR><TD COLSPAN="3" BGCOLOR="#2e8b57"><FONT COLOR="white"><B>CIDADE</B></FONT></TD></TR>
      <TR><TD><B>PK</B></TD><TD ALIGN="LEFT"><B>id_cidade</B></TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">uf</TD><TD ALIGN="LEFT">CHAR(2)</TD></TR>
    </TABLE>>];

  CLIENTE   -> CONTRATO [label="  assina  ",       taillabel="1", headlabel="N"];
  PLANO     -> CONTRATO [label="  é contratado em  ", taillabel="1", headlabel="N"];
  ENDERECO  -> CONTRATO [label="  é local de instalação de  ", taillabel="1", headlabel="N"];
  CIDADE    -> ENDERECO [label="  abriga  ",    taillabel="1", headlabel="N"];
  CONTRATO  -> FATURA   [label="  gera  ",         taillabel="1", headlabel="N"];
  FATURA    -> PAGAMENTO[label="  é quitada por  ",taillabel="1", headlabel="N"];
  CONTRATO  -> CHAMADO  [label="  origina  ",      taillabel="1", headlabel="N"];
  TECNICO   -> CHAMADO  [label="  atende  ",       taillabel="1", headlabel="N"];

  LEGENDA [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#999999">
      <TR><TD ALIGN="LEFT"><B>Legenda</B></TD></TR>
      <TR><TD ALIGN="LEFT">PK = chave primária | FK = chave estrangeira | UK = valor único</TD></TR>
      <TR><TD ALIGN="LEFT">1 = um | N = muitos (relação do lado 1 para o lado N)</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#2e8b57"><B>Verde</B></FONT> = entidades criadas pela normalização (ENDEREÇO e CIDADE)</TD></TR>
      <TR><TD ALIGN="LEFT">Notação pé de galinha: traço duplo = exatamente um; pé + círculo = zero ou muitos</TD></TR>
    </TABLE>>];
}
